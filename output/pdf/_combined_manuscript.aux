\@writefile{lof}{\contentsline {figure}{\numberline {33}{\ignorespaces Speed--distance iso-lines of the access crystal: each curve is the locus \(d = v\,\mittau \) for one fixed access time \(\mittau \) --- the \(c = d/t\) lattice, computed with the tested functions in \texttt {textbook.models}. Steeper iso-lines correspond to shorter access times, so the same distance is reached at lower speed whenever the access budget is longer. The topmost curve carries the corpus's anchor speed \(c\), the filing's picture of one trip stored once as a single crystal rather than as three clocks.}}{140}{figure.caption.78}\protected@file@percent }
\newlabel{fig:part_II_crystalline-field}{{33}{140}{Speed--distance iso-lines of the access crystal: each curve is the locus \(d = v\,\tau \) for one fixed access time \(\tau \) --- the \(c = d/t\) lattice, computed with the tested functions in \protect \texttt {textbook.models}. Steeper iso-lines correspond to shorter access times, so the same distance is reached at lower speed whenever the access budget is longer. The topmost curve carries the corpus's anchor speed \(c\), the filing's picture of one trip stored once as a single crystal rather than as three clocks}{figure.caption.78}{}}
\newlabel{fig:part_II_crystalline-field@cref}{{[figure][33][]33}{[1][140][]140}{}{}{}}
