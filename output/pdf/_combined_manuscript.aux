\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces El Gran Sol's Fractal constant at work: the octave ladder \(\mitPhi ^n\) for \(n = 1,\dots  ,6\) rises geometrically from \(1.618034\) to \(17.944272\) and reads as a straight line on a logarithmic axis. The Fibonacci ratios \(\mitvarphi _{\text  {fib}}(5) = 1.6\) and \(\mitvarphi _{\text  {fib}}(10) \approx 1.618182\) are overlaid on the same panel and close in on \(\mitPhi \approx 1.618\) from below. Both series are produced deterministically by \breaktt {textbook.models.phi\_powers(6)} and \breaktt {textbook.models.phi\_fibonacci}, so the exponent and subscript readings of the octave recursion share one plot.}}{71}{figure.caption.31}\protected@file@percent }
\newlabel{fig:part_I_fractal-constant}{{14}{71}{El Gran Sol's Fractal constant at work: the octave ladder \(\Phi ^n\) for \(n = 1,\dots ,6\) rises geometrically from \(1.618034\) to \(17.944272\) and reads as a straight line on a logarithmic axis. The Fibonacci ratios \(\varphi _{\text {fib}}(5) = 1.6\) and \(\varphi _{\text {fib}}(10) \approx 1.618182\) are overlaid on the same panel and close in on \(\Phi \approx 1.618\) from below. Both series are produced deterministically by \protect \breaktt {textbook.models.phi\_powers(6)} and \protect \breaktt {textbook.models.phi\_fibonacci}, so the exponent and subscript readings of the octave recursion share one plot}{figure.caption.31}{}}
