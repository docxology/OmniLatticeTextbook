\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces The 99-octave ladder on a log scale: band boundaries from \breaktt {octave\_term(omega0=1,\ n,\ convention)} in \texttt {textbook.models}, plotted for both conventions --- the exponent reading growing geometrically as \ensuremath  {\mitPhi }\^{}n and the subscript reading saturating at the Fibonacci ratio near \ensuremath  {\mitPhi } --- with a side panel overlaying the Fibonacci ratio converging to the pinned \ensuremath  {\mitPhi } \ensuremath  {\approx } 1.6180339887. Notice the widening gap between the two curves: same ambiguous corpus notation, but at the fifth rung the readings differ by nearly a factor of seven, so every computed band must declare its convention.}}{62}{figure.caption.25}\protected@file@percent }
\newlabel{fig:part_0_octave-map}{{11}{62}{The 99-octave ladder on a log scale: band boundaries from \protect \breaktt {octave\_term(omega0=1,\ n,\ convention)} in \protect \texttt {textbook.models}, plotted for both conventions --- the exponent reading growing geometrically as \texorpdfstring {\ensuremath {\Phi }}{Phi}\^{}n and the subscript reading saturating at the Fibonacci ratio near \texorpdfstring {\ensuremath {\Phi }}{Phi} --- with a side panel overlaying the Fibonacci ratio converging to the pinned \texorpdfstring {\ensuremath {\Phi }}{Phi} \texorpdfstring {\ensuremath {\approx }}{~} 1.6180339887. Notice the widening gap between the two curves: same ambiguous corpus notation, but at the fifth rung the readings differ by nearly a factor of seven, so every computed band must declare its convention}{figure.caption.25}{}}
