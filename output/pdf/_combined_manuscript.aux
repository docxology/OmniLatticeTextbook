\@writefile{lof}{\contentsline {figure}{\numberline {46}{\ignorespaces Prime-container capacity: the growth sequence of \breaktt {textbook.models.unique\_address} as odd-prime vaults join the registry one at a time, each vault contributing an exponent budget of addresses on top of the binary anchor. Every additional vault prime multiplies the number of distinct residue-index addresses rather than adding to it, because each address is the product \(\prod p_i^{e_i}\) over the vault primes and their occupancies. The takeaway is the compounding itself --- the visual signature of a vault architecture whose encoding is injective and reversible by the fundamental theorem of arithmetic.}}{187}{figure.caption.109}\protected@file@percent }
\newlabel{fig:part_III_protein-folding}{{46}{187}{Prime-container capacity: the growth sequence of \protect \breaktt {textbook.models.unique\_address} as odd-prime vaults join the registry one at a time, each vault contributing an exponent budget of addresses on top of the binary anchor. Every additional vault prime multiplies the number of distinct residue-index addresses rather than adding to it, because each address is the product \(\prod p_i^{e_i}\) over the vault primes and their occupancies. The takeaway is the compounding itself --- the visual signature of a vault architecture whose encoding is injective and reversible by the fundamental theorem of arithmetic}{figure.caption.109}{}}
